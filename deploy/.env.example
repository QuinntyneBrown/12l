# Copy to /opt/12l/.env on the server. Never commit the real file.
IMAGE_PREFIX=ghcr.io/quinntynebrown
IMAGE_TAG=latest
SITE_ADDRESS=12l.ca, www.12l.ca

ConnectionStrings__TwelveL=Server=tcp:<server>.database.windows.net,1433;Database=TwelveL;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30
Auth__SigningKey=<64 random characters>
Notifications__UnsubscribeSigningKey=<64 random characters>
App__BaseUrl=https://12l.ca
