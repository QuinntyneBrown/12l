@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View a listing's detail

Person(viewer, "Visitor or member", "Views one listing")
Container_Boundary(web, "12L Web") {
  Component(page, "ListingDetailPageComponent", "Angular route component", "items/:reference, view states")
  Component(store, "ListingDetailStore", "Angular signal store", "Listing, viewState, primaryAction")
  Component(gallery, "ListingGalleryComponent", "Angular component", "Thumbnails, swipe below 992 px")
  Component(info, "ListingInfoComponent", "Angular component", "Price, facts, flaws, Reserved alert")
  Component(seller, "SellerSummaryComponent", "Angular component", "Rating or New seller, profile link")
  Component(buybar, "BuyBarComponent", "Angular component", "Buy now, sign in to buy, Edit and Withdraw")
  Component(client, "ListingDetailApiService", "Angular HTTP client", "GET listing by reference")
}
Container_Boundary(api, "12L API") {
  Component(ctrl, "CatalogController", "ASP.NET Core controller", "GET /api/catalog/listings/{reference}")
  Component(handler, "GetListingDetailQueryHandler", "MediatR handler", "Visibility, display status, viewer relation")
  Component(vis, "ListingDetailVisibility", "Domain specification", "Draft and Removed only for the seller")
  Component(rs, "ListingDetailReadStore", "IListingDetailReadStore, EF Core", "Listing, photos, seller in one query")
  Component(checkout, "Checkout start handler", "MediatR handler (orders)", "Calls Listing.EnsureCanBePurchasedBy")
  Component(listing, "Listing", "Domain aggregate (listings)", "EnsureCanBePurchasedBy guard")
}
ContainerDb(db, "12L database", "SQL Server", "Listings, ListingPhotos, Members")

Rel(viewer, page, "Opens /items/{reference}")
Rel(page, store, "load(reference)")
Rel(page, gallery, "Renders")
Rel(page, info, "Renders")
Rel(info, seller, "Renders")
Rel(info, buybar, "Renders")
Rel(store, client, "Requests listing")
Rel(client, ctrl, "GET with credentials", "JSON/HTTPS")
Rel(ctrl, handler, "GetListingDetailQuery")
Rel(handler, vis, "CanView")
Rel(handler, rs, "GetAsync(reference)")
Rel(rs, db, "Reads", "EF Core")
Rel(buybar, checkout, "Buy now leads to checkout", "via /checkout/{reference}")
Rel(checkout, listing, "EnsureCanBePurchasedBy(buyerId)")
@enduml
