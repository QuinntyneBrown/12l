@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Browse the catalog

enum ListingStatus {
  Draft
  Active
  Reserved
  Sold
  Removed
}

class CatalogVisibility <<specification>> {
  +IsVisible(status: ListingStatus): bool
  +DisplayStatus(status: ListingStatus, reservedUntil: DateTimeOffset?, now: DateTimeOffset): ListingStatus
}

class SearchCatalogQuery <<record>> {
  +int Page
  +int PageSize
  +CatalogCriteria Criteria
}

class CatalogCriteria <<record>> {
  +{static} CatalogCriteria Empty
}

class SearchCatalogQueryValidator {
  +SearchCatalogQueryValidator()
}

class SearchCatalogQueryHandler {
  +Handle(query: SearchCatalogQuery, ct: CancellationToken): Task<CatalogPageDto>
}

interface ICatalogReadStore {
  +SearchAsync(criteria: CatalogCriteria, skip: int, take: int, now: DateTimeOffset, ct: CancellationToken): Task<CatalogSearchResult>
}

class CatalogReadStore {
  -TwelveLDbContext db
  +SearchAsync(...): Task<CatalogSearchResult>
}

class CatalogSearchResult {
  +IReadOnlyList<CatalogRow> Rows
  +int TotalCount
}

interface IPhotoUrlBuilder {
  +Build(version: PhotoVersionRow): string
}

class CdnPhotoUrlBuilder {
  -string cdnBaseUrl
  +Build(version: PhotoVersionRow): string
}

class CatalogOptions {
  +int DefaultPageSize = 24
  +int MaxPageSize = 48
}

class CatalogPageDto {
  +ListingCardDto[] Items
  +int Page
  +int PageSize
  +int TotalCount
}

class ListingCardDto {
  +Guid Id
  +string Reference
  +string Title
  +string Brand
  +string Category
  +string Subcategory
  +string Size
  +string Condition
  +string Price
  +string Status
  +DateTimeOffset PublishedAt
  +PhotoDto CoverPhoto
}

class PhotoDto {
  +int Width
  +int Height
  +string Alt
  +PhotoSourceSet Webp
  +PhotoSourceSet Jpeg
}

class CatalogController {
  +GetListings(page: int, pageSize: int?, criteria): Task<ActionResult<CatalogPageDto>>
}

SearchCatalogQuery --> CatalogCriteria : has
SearchCatalogQueryValidator ..> SearchCatalogQuery : validates
CatalogController ..> SearchCatalogQuery : sends
SearchCatalogQueryHandler ..> SearchCatalogQuery : handles
SearchCatalogQueryHandler --> ICatalogReadStore : reads through
SearchCatalogQueryHandler --> IPhotoUrlBuilder : builds URLs with
SearchCatalogQueryHandler --> CatalogOptions : caps page size with
SearchCatalogQueryHandler ..> CatalogVisibility : display status
CatalogReadStore ..|> ICatalogReadStore
CdnPhotoUrlBuilder ..|> IPhotoUrlBuilder
CatalogReadStore ..> CatalogVisibility : filters with
CatalogVisibility ..> ListingStatus
ICatalogReadStore ..> CatalogSearchResult : returns
SearchCatalogQueryHandler ..> CatalogPageDto : returns
CatalogPageDto "1" *-- "0..48" ListingCardDto
ListingCardDto *-- PhotoDto
@enduml
