@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Browse the catalog

Person(visitor, "Visitor or member", "Browses listings")
Container_Boundary(web, "12L Web") {
  Component(page, "CatalogPageComponent", "Angular route component", "Renders hero, grid and view states")
  Component(store, "CatalogStore", "Angular signal store", "Pages, appends and de-duplicates cards")
  Component(snap, "CatalogSnapshotStore", "Angular service", "Keeps the last first page for offline use")
  Component(card, "ListingCardComponent", "Angular component", "Cover photo, size tag, brand, title, condition, price")
  Component(photo, "ResponsivePhotoComponent", "Angular component", "picture element with srcset, width, height, lazy loading")
  Component(client, "CatalogApiService", "Angular HTTP client", "Typed calls to /api/catalog")
}
Container_Boundary(api, "12L API") {
  Component(ctrl, "CatalogController", "ASP.NET Core controller", "GET /api/catalog/listings")
  Component(handler, "SearchCatalogQueryHandler", "MediatR handler", "Caps page size, applies CatalogVisibility")
  Component(urls, "CdnPhotoUrlBuilder", "IPhotoUrlBuilder", "Content-addressed CDN URLs")
  Component(readstore, "CatalogReadStore", "ICatalogReadStore, EF Core", "Count and page queries")
}
ContainerDb(db, "12L database", "SQL Server", "Listings, ListingPhotos, ListingPhotoVersions")

Rel(visitor, page, "Opens /")
Rel(page, store, "Reads state, calls load and loadMore")
Rel(page, card, "Renders one per listing")
Rel(card, photo, "Renders cover photo with")
Rel(store, client, "Requests pages through")
Rel(store, snap, "Saves and restores first page")
Rel(client, ctrl, "GET /api/catalog/listings", "JSON/HTTPS")
Rel(ctrl, handler, "Sends SearchCatalogQuery")
Rel(handler, readstore, "SearchAsync")
Rel(handler, urls, "Builds photo URLs")
Rel(readstore, db, "Reads", "EF Core, IX_Listings_Catalog_Newest")
@enduml
