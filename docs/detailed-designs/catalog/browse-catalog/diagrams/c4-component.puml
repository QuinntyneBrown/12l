@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Browse the catalog

Person(visitor, "Visitor or member", "Browses listings")
Container_Boundary(web, "12L Web") {
  Component(page, "CatalogPage", "@12l/catalog route component", "Hero or category header, count, grid and view states")
  Component(store, "CatalogStore", "@12l/catalog signal store", "Pages, appends, de-duplicates and keeps the offline snapshot")
  Component(grid, "tl-listing-grid / tl-listing-card", "@12l/components", "Responsive grid, picture with srcset, skeletons")
  Component(states, "tl-load-more, tl-empty-state, tl-alert", "@12l/components", "Load more, empty and error states, offline banner")
  Component(client, "CatalogApi", "@12l/api typed HTTP client", "GET /api/catalog/listings")
}
Container_Boundary(api, "12L API") {
  Component(ctrl, "CatalogController", "ASP.NET Core controller", "GET /api/catalog/listings, anonymous")
  Component(handler, "BrowseCatalogQueryHandler", "MediatR handler", "Validates, caps page size, applies CatalogVisibility, builds photo URLs")
}
ContainerDb(db, "12L database", "SQL Server", "Listings, ListingPhotos, ListingPhotoVersions")

Rel(visitor, page, "Opens / or /shoes, /tops...")
Rel(page, store, "Reads state, calls load, retry and loadMore")
Rel(page, grid, "Renders cards with")
Rel(page, states, "Renders states with")
Rel(store, client, "Requests pages through")
Rel(client, ctrl, "GET /api/catalog/listings", "JSON/HTTPS")
Rel(ctrl, handler, "Sends BrowseCatalogQuery")
Rel(handler, db, "Count and page queries", "EF Core, IX_Listings_Status_PublishedAt")
@enduml
