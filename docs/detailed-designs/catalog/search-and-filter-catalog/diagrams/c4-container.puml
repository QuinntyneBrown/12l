@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Search and filter the catalog

Person(visitor, "Visitor or member", "Narrows the catalog")
System_Boundary(twelvel, "12L") {
  Container(web, "12L Web", "Angular", "Search form, filter sidebar and panel, URL-held result set")
  Container(api, "12L API", "ASP.NET Core", "GET /api/catalog/listings, /listings/count, /brands")
  ContainerDb(db, "12L database", "SQL Server", "Listings with full-text index on SearchHeadline and SearchBody")
  ContainerDb(cache, "Distributed cache", "Redis", "catalog:brands:v1 facet, 60 s")
}
Rel(visitor, web, "Uses", "HTTPS")
Rel(web, api, "Sends criteria", "JSON/HTTPS")
Rel(api, db, "Full-text and filtered queries", "EF Core")
Rel(api, cache, "Reads and writes brand facet", "RESP")
@enduml
