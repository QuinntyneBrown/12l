@startuml
title UML sequence behaviour — Apply filters in the filter panel
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Visitor or member" as actor
box "Frontend — 12L Web application" #E0F2FE
  participant "FiltersPanelDialogComponent" as panel
  participant "CatalogFiltersFormComponent" as form
  participant "CatalogApiService" as client
  participant "CatalogPageComponent" as page
end box
box "Backend — 12L API application" #D1FADF
  participant "CatalogController" as controller
end box
box "Backend — TwelveL Application and Domain" #ECFDF3
  participant "SearchCatalogQueryValidator" as val
  participant "CountCatalogListingsQueryHandler" as count
end box
box "Backend — TwelveL Infrastructure" #FFF4E5
  database "12L database" as db
end box
actor -> panel : Tap "Filters" (viewport under 992 px)
panel --> actor : Full screen under 768 px, side panel 768-991 px (L2-062)
actor -> form : Choose Shoes, New with tags, price 200 to 50
form -> form : priceRangeValidator
alt minimum greater than maximum
  form --> panel : invalid
  panel --> actor : "Check the price range", "Minimum price must be lower than maximum",\n"Show items" disabled (L2-024)
else valid range (after correction to 20 to 200)
  panel --> actor : busy, "Show items" aria-busy
  panel -> client : countListings(draft) debounced 300 ms, switchMap
  client -> controller : GET /api/catalog/listings/count?category=shoes&condition=new-with-tags&minPrice=20&maxPrice=200
  controller -> val : Validate criteria
  alt criteria invalid (direct request)
    val --> controller : CATALOG_PRICE_RANGE_INVALID or CATALOG_FILTER_INVALID
    controller --> client : 400 problem details with field errors
  else criteria valid
    controller -> count : Send CountCatalogListingsQuery
    count -> db : COUNT with filters AND-ed, values OR-ed (L2-024)
    db --> count : 38
    count --> controller : 38
    controller --> client : 200 {"totalCount": 38}
    client --> panel : 38
    panel --> actor : "Show 38 items"
    actor -> panel : Choose "Show 38 items"
    panel -> page : navigate("/", canonical params), close, focus "Filters"
    page -> page : Parse URL and load results (see browse-catalog)
    page --> actor : Results with chips "Shoes", "New with tags", "$20–$200"
  end
end
@enduml
