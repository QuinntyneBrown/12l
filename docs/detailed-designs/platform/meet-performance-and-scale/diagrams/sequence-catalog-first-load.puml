@startuml
title UML sequence behaviour — Catalog first load with lazy feature areas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor on a phone" as actor
box "Frontend — 12L Web application" #E0F2FE
  participant "Browser" as browser
  participant "Router + FlagPreloadingStrategy" as router
  participant "CatalogPage" as page
  participant "WebVitalsReporter" as vitals
end box
box "Backend — 12L API application" #D1FADF
  participant "CatalogController" as api
  participant "TelemetryController" as tele
end box
actor -> browser : Open /
browser -> browser : Download index.html and initial JS (<= 250 KB gzipped, L2-058)
browser -> router : Bootstrap application
router -> page : Activate eager catalog route
page -> api : GET /api/v1/catalog?page=1
page -> page : Render skeleton cards at final size (no layout shift)
api --> page : Listings
page --> actor : First screen of listings (LCP <= 2.5 s)
router -> browser : Preload listing-detail chunk only (data.preload)
note right of browser : Selling, checkout and administration chunks are not requested (L2-058 AC3)
opt Visitor navigates to /sell
  router -> browser : Fetch listings chunk on demand
end
vitals -> tele : sendBeacon LCP, CLS, INP
tele --> vitals : 204
@enduml
