@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Meet performance and scale targets

Container_Boundary(web, "12L Web") {
  Component(routes, "app.routes.ts", "Angular routes", "Shell, catalog and error pages eager; others loadChildren")
  Component(preload, "FlagPreloadingStrategy", "PreloadingStrategy", "Preloads listing detail only")
  Component(vitals, "WebVitalsReporter", "Angular service", "Sends LCP, CLS, INP with sendBeacon")
}
Container_Boundary(api, "12L API") {
  Component(tele, "TelemetryController", "Controller", "POST /api/v1/telemetry/web-vitals -> 204")
  Component(kind, "EndpointKindAttribute", "Endpoint metadata", "Read, Write, PaymentBound")
  Component(dp, "Data Protection", "ASP.NET Core", "Key ring persisted to Redis")
  Component(rlstore, "RedisFixedWindowRateLimitStore", "IRateLimitStore", "From harden-http-and-api")
  Component(tokens, "Refresh-token store", "Accounts adapter", "Token families in Redis")
  Component(factory, "RedisConnectionFactory", "Singleton", "IConnectionMultiplexer, prefix 12l:")
  Component(queries, "Read query handlers", "MediatR handlers", "AsNoTracking projections, pages of 24")
}
ContainerDb(cache, "Distributed cache", "Redis", "Shared state")
ContainerDb(db, "12L database", "SQL Server", "Business data")

Rel(routes, preload, "Uses")
Rel(vitals, tele, "Posts metrics", "HTTPS")
Rel(dp, factory, "Uses")
Rel(rlstore, factory, "Uses")
Rel(tokens, factory, "Uses")
Rel(factory, cache, "Connects", "RESP/TLS")
Rel(queries, db, "Projects rows", "EF Core")
Rel(kind, queries, "Tags endpoints of")
@enduml
