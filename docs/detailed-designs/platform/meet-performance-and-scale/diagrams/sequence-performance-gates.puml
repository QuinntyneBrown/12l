@startuml
title UML sequence behaviour — Performance gates in CI
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Developer" as dev
participant "GitHub pull request" as pr
box "Build — GitHub Actions CI" #FFF4E5
  participant "ng build --stats-json" as build
  participant "check-bundle-budget.mjs" as budget
  participant "check-lazy-chunks.mjs" as lazy
  participant "Lighthouse CI" as lh
  participant "load-test.yml (k6)" as k6
end box
participant "Performance environment" as perf
dev -> pr : Push frontend change
pr -> build : Production build
build -> budget : dist + stats.json
alt Initial JS gzipped > 256,000 bytes
  budget --> pr : Fail with chunk size table (L2-058)
else Within budget
  budget -> lazy : Continue
  alt Selling, checkout or admin module in initial chunk
    lazy --> pr : Fail naming the module (L2-058)
  else Lazy split intact
    lazy -> lh : Run mobile preset on / and /listings/{id}
    alt LCP > 2500 ms or CLS > 0.1 or TBT > 200 ms
      lh --> pr : Fail with report
    else Within budget
      lh --> pr : Pass
    end
  end
end
== Weekly and before release ==
k6 -> perf : 200 req/s for 10 min, 100,000 Active listings
perf --> k6 : Latencies and errors
alt Read p95 >= 300 ms or write p95 >= 800 ms or failures >= 0.1%
  k6 --> pr : Fail run and upload summary (L2-057)
else Within budget
  k6 --> pr : Pass and upload summary
end
@enduml
