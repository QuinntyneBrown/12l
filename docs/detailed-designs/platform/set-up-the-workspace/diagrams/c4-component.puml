@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Set up the workspace

Container_Boundary(web, "12L Web (src/frontend)") {
  Component(app, "projects/twelvel", "Application", "AppComponent, AppShellComponent, HomePlaceholderPage, app.routes.ts")
  Component(feat, "projects/accounts … privacy", "Six feature libraries", "Empty lazy route tables")
  Component(apilib, "projects/api", "Library @12l/api", "provideApi(), API_BASE_URL")
  Component(comps, "projects/components", "Library @12l/components", "tokens.css, components.css, tl-skip-link, tl-logo, tl-top-bar, tl-footer, tl-toast-region")
  Component(e2e, "e2e/", "Playwright", "shell.page.ts, shell.spec.ts")
}
Container_Boundary(be, "12L API (src/backend)") {
  Component(apiproj, "TwelveL.Api", "ASP.NET Core", "HealthController: GET /api/health")
  Component(appproj, "TwelveL.Application", "Class library", "Marker only")
  Component(dom, "TwelveL.Domain", "Class library", "Marker only")
  Component(infra, "TwelveL.Infrastructure", "Class library", "Marker only")
  Component(worker, "TwelveL.Worker", "Worker service", "Empty hosted service")
  Component(mig, "TwelveL.Migrator", "Console", "No migrations yet")
}
Container_Boundary(t, "tests/") {
  Component(apitests, "TwelveL.Api.Tests", "xUnit", "HealthEndpointTests, StatelessApiTests (L2-060)")
  Component(other, "TwelveL.*.Tests", "xUnit", "One smoke test each")
}
Rel(app, feat, "loadChildren")
Rel(app, comps, "Shell components")
Rel(app, apilib, "provideApi()")
Rel(feat, apilib, "Imports")
Rel(feat, comps, "Imports")
Rel(e2e, app, "Loads /")
Rel(apiproj, appproj, "References")
Rel(apiproj, infra, "References")
Rel(appproj, dom, "References")
Rel(infra, appproj, "References")
Rel(worker, infra, "References")
Rel(mig, infra, "References")
Rel(apitests, apiproj, "WebApplicationFactory, NetArchTest")
Rel(other, dom, "References each project")
@enduml
