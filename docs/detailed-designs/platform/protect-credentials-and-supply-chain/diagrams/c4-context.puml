@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Protect credentials and the supply chain

Person(member, "Member", "Signs in with an email and password")
Person(dev, "Developer", "Changes 12L through pull requests")
System(twelvel, "12L", "Marketplace; stores only password hashes")
System_Ext(vault, "Secret store", "Hosting platform vault <TO SUPPLY>")
System_Ext(github, "GitHub", "Repository, Actions CI, code scanning")
System_Ext(advisories, "Vulnerability databases", "Advisories for NuGet and npm packages")

Rel(member, twelvel, "Signs in to", "HTTPS")
