@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Leave a review

enum ReviewStatus {
  Hidden
  Published
}

enum ReviewerRole {
  Buyer
  Seller
}

class Review {
  +Guid Id
  +Guid OrderId
  +Guid AuthorMemberId
  +Guid SubjectMemberId
  +ReviewerRole AuthorRole
  +int Stars
  +string? Comment
  +DateTimeOffset CreatedAt
  +DateTimeOffset WindowClosesAt
  +ReviewStatus Status
  +DateTimeOffset? PublishedAt
  +byte[] RowVersion
  +{static} Create(orderId, author, subject, role, stars, comment, completedAt, now): Review
  +Publish(now: DateTimeOffset): void
  +AddReply(text: string, now: DateTimeOffset): void
}

class ReviewReply <<value object>> {
  +string Text
  +DateTimeOffset PostedAt
}

class ReviewPublished <<domain event>> {
  +Guid ReviewId
  +Guid SubjectMemberId
  +int Stars
}

class CreateReviewCommand {
  +Guid OrderId
  +Guid AuthorMemberId
  +int Stars
  +string? Comment
}

class CreateReviewCommandValidator
class CreateReviewCommandHandler {
  +Handle(command: CreateReviewCommand): Task<Result<ReviewDto>>
}

class PostReviewReplyCommand {
  +Guid ReviewId
  +Guid SubjectMemberId
  +string Text
}

class PostReviewReplyCommandHandler {
  +Handle(command: PostReviewReplyCommand): Task<Result<ReviewReplyDto>>
}

class PublishDueReviewsCommandHandler {
  +Handle(command: PublishDueReviewsCommand): Task<int>
}

class GetOrderReviewsQueryHandler {
  +Handle(query: GetOrderReviewsQuery): Task<OrderReviewsDto>
}

class OrderReviewsDto {
  +bool CanReview
  +DateTimeOffset? WindowClosesAt
  +string CounterpartDisplayName
  +ReviewDto? MyReview
  +ReviewDto? TheirReview
}

interface IOrderReviewEligibilityReader {
  +GetAsync(orderId: Guid): Task<OrderReviewEligibility?>
}

class OrderReviewEligibility {
  +Guid OrderId
  +string Status
  +Guid BuyerMemberId
  +Guid SellerMemberId
  +DateTimeOffset? CompletedAt
}

class ReviewPublishedHandler {
  +Handle(event: ReviewPublished): Task
}

interface IOutbox {
  +Enqueue(message: EmailNotificationRequested): void
}

Review --> ReviewStatus : has
Review --> ReviewerRole : has
Review "1" *-- "0..1" ReviewReply : owns
Review ..> ReviewPublished : raises
CreateReviewCommandValidator ..> CreateReviewCommand : validates
CreateReviewCommandHandler ..> CreateReviewCommand : handles
CreateReviewCommandHandler ..> IOrderReviewEligibilityReader : uses
IOrderReviewEligibilityReader ..> OrderReviewEligibility : returns
CreateReviewCommandHandler --> Review : creates / publishes
PostReviewReplyCommandHandler ..> PostReviewReplyCommand : handles
PostReviewReplyCommandHandler --> Review : adds reply
PublishDueReviewsCommandHandler --> Review : publishes
GetOrderReviewsQueryHandler ..> OrderReviewsDto : builds
GetOrderReviewsQueryHandler --> Review : reads
ReviewPublishedHandler ..> ReviewPublished : handles
ReviewPublishedHandler ..> IOutbox : enqueues ReviewReceived
@enduml
