@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Leave a review

Container(web, "12L Web", "Angular", "OrderReviewPanelComponent, LeaveReviewDialogComponent, ReplyToReviewDialogComponent, ReviewsApiService")

Container_Boundary(api, "12L API") {
  Component(ctrl, "ReviewsController", "ASP.NET Core controller", "Exposes review and reply endpoints under MemberOnly and TradingMember policies")
  Component(create, "CreateReviewCommandHandler", "MediatR handler", "Enforces L2-038 and publishes both reviews when the counterpart has reviewed")
  Component(query, "GetOrderReviewsQueryHandler", "MediatR handler", "Applies the blind-review visibility rule")
  Component(reply, "PostReviewReplyCommandHandler", "MediatR handler", "Adds the single reply")
  Component(validators, "Review validators", "FluentValidation", "Stars 1 to 5, comment and reply up to 500 characters")
  Component(review, "Review", "Domain aggregate", "Hidden to Published state machine and reply")
  Component(published, "ReviewPublishedHandler", "MediatR notification handler", "Enqueues ReviewReceived email")
  Component(elig, "IOrderReviewEligibilityReader", "Read port", "Order status, parties and CompletedAt")
  Component(outbox, "IOutbox", "Infrastructure port", "Writes OutboxMessages in the same transaction")
}
Container_Boundary(worker, "12L Worker") {
  Component(job, "ReviewPublishingJob", "Hosted service", "Sends PublishDueReviewsCommand on a timer")
  Component(publish, "PublishDueReviewsCommandHandler", "MediatR handler", "Publishes hidden reviews past WindowClosesAt")
}
ContainerDb(db, "12L database", "SQL Server", "Reviews, Orders, OutboxMessages")

Rel(web, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, validators, "Validates with")
Rel(ctrl, create, "Sends CreateReviewCommand")
Rel(ctrl, query, "Sends GetOrderReviewsQuery")
Rel(ctrl, reply, "Sends PostReviewReplyCommand")
Rel(create, elig, "Checks order eligibility")
Rel(create, review, "Creates and publishes")
Rel(reply, review, "Adds reply")
Rel(review, published, "Raises ReviewPublished")
Rel(published, outbox, "Enqueues EmailNotificationRequested")
Rel(job, publish, "Sends PublishDueReviewsCommand")
Rel(publish, review, "Publishes")
Rel(elig, db, "Reads Orders", "EF Core")
Rel(create, db, "Saves Reviews", "EF Core")
Rel(query, db, "Reads Reviews", "EF Core")
Rel(outbox, db, "Writes OutboxMessages", "EF Core")
@enduml
