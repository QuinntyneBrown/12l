@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Leave a review

Person(buyer, "Buyer", "Member who bought an item")
Person(seller, "Seller", "Member who sold the item")
System(twelvel, "12L", "Marketplace for men's US size 12 shoes and size L clothing")
System_Ext(email, "Email provider", "Sends transactional email")

Rel(buyer, twelvel, "Reviews the seller and replies to reviews using", "HTTPS")
Rel(seller, twelvel, "Reviews the buyer and replies to reviews using", "HTTPS")
Rel(twelvel, email, "Sends review received email via", "HTTPS API")
Rel(email, seller, "Delivers email to")
Rel(email, buyer, "Delivers email to")
@enduml
