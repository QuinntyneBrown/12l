@startuml
title UML sequence behaviour — Leave a review
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Buyer or seller" as actor
box "Frontend — 12L Web application" #E0F2FE
  participant "OrderReviewPanelComponent" as panel
  participant "LeaveReviewDialogComponent" as dialog
  participant "ReviewsApiService" as client
end box
box "Backend — 12L API application" #D1FADF
  participant "ReviewsController" as controller
end box
box "Backend — TwelveL Application and Domain" #ECFDF3
  participant "CreateReviewCommandHandler" as handler
  participant "Review" as review
  participant "ReviewPublishedHandler" as published
end box
box "Backend — TwelveL Infrastructure" #FFF4E5
  participant "IOrderReviewEligibilityReader" as elig
  database "12L database" as db
end box
actor -> panel : Choose "Leave a review"
panel -> dialog : Open "Review {displayName}"
actor -> dialog : Pick stars, type optional comment, "Post review"
dialog -> dialog : Client validation (1 to 5 stars, 500 characters)
alt client validation fails
  dialog --> actor : Error summary "Choose a rating" / "Keep the comment to 500 characters"
else form valid
  dialog -> client : createReview(orderId, {stars, comment})
  client -> controller : POST /api/orders/{orderId}/reviews
  controller -> controller : MemberPolicy + VerifiedActiveMemberPolicy
  controller -> controller : CreateReviewCommandValidator (L2-038)
  alt validator fails
    controller --> client : 400 review.invalid with field errors
    client --> dialog : Field errors
    dialog --> actor : Inline errors
  else valid command
    controller -> handler : Send CreateReviewCommand
    handler -> elig : GetAsync(orderId)
    elig -> db : Read Orders row
    db --> elig : Status, parties, CompletedAt
    elig --> handler : OrderReviewEligibility
    alt caller is not the buyer or seller
      handler --> controller : NotFound
      controller --> client : 404 problem details
    else order is not Completed
      handler --> controller : Conflict review.order_not_completed (L2-038)
      controller --> client : 409 problem details
    else now > CompletedAt + 30 days
      handler --> controller : Conflict review.window_closed (L2-038)
      controller --> client : 409 problem details
    else author already reviewed this order
      handler --> controller : Conflict review.already_submitted (L2-038)
      controller --> client : 409 problem details
    else eligible
      handler -> review : Create(stars, comment, WindowClosesAt = CompletedAt + 30 days)
      review --> handler : Hidden review
      handler -> db : Load counterpart review for the order
      db --> handler : Counterpart review or none
      opt counterpart has already reviewed (L2-039)
        handler -> review : Publish(now) on both reviews
        review -> published : ReviewPublished for each review
        published -> db : Enqueue ReviewReceived outbox messages (L2-042)
      end
      handler -> db : Save Reviews and OutboxMessages in one transaction
      alt unique index UX_Reviews_OrderId_AuthorMemberId violated
        db --> handler : Duplicate key
        handler --> controller : Conflict review.already_submitted
        controller --> client : 409 problem details
      else committed
        db --> handler : Commit result
        handler --> controller : ReviewDto
        controller --> client : 201 Created
        client --> dialog : Review saved
        dialog --> actor : "Review saved" — published once the other party reviews or at window end
      end
    end
  end
end
@enduml
