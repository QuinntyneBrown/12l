@startuml
title UML sequence behaviour — Publish reviews when the window ends
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — 12L Worker application" #D1FADF
  participant "ReviewPublishingJob" as job
end box
box "Backend — TwelveL Application and Domain" #ECFDF3
  participant "PublishDueReviewsCommandHandler" as handler
  participant "Review" as review
  participant "ReviewPublishedHandler" as published
end box
box "Backend — TwelveL Infrastructure" #FFF4E5
  database "12L database" as db
end box
loop every Reviews:PublishingJobInterval
  job -> handler : Send PublishDueReviewsCommand(now)
  loop until no due reviews remain
    handler -> db : Select Hidden reviews with WindowClosesAt <= now (IX_Reviews_WindowClosesAt), batch
    db --> handler : Due reviews
    handler -> review : Publish(now) (L2-039)
    review -> published : ReviewPublished
    published -> db : Enqueue ReviewReceived outbox message (L2-042)
    handler -> db : Save batch in one transaction
    alt RowVersion conflict (already published elsewhere)
      db --> handler : DbUpdateConcurrencyException
      handler -> handler : Reload and skip published reviews
    else committed
      db --> handler : Commit result
    end
  end
  handler --> job : Count published
  job -> job : Log count and failures with correlation ID (L2-069)
end
@enduml
