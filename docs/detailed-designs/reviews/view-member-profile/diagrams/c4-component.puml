@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View a member profile

Container(web, "12L Web", "Angular", "@12l/reviews MemberProfilePage and MemberProfileStore; @12l/api MembersApi; @12l/components tl-rating-summary")

Container_Boundary(api, "12L API") {
  Component(ctrl, "MembersController", "ASP.NET Core controller", "Anonymous; Cache-Control public 60 s, no-store on 404")
  Component(qprofile, "GetPublicProfileQueryHandler", "MediatR handler", "PublicProfileDto or MEMBER_UNAVAILABLE")
  Component(qlist, "GetMemberListingsQueryHandler", "MediatR handler", "Active listings, 24 per page, newest first")
  Component(cards, "CatalogCards", "Mapper", "ListingCardDto with the cover photo, shared with the catalog")
  Component(port, "ITwelveLDbContext", "Persistence port", "Members, Orders, Listings, ListingPhotos")
}
ContainerDb(db, "12L database", "SQL Server", "Members (ClosedAt), Orders, Listings, ListingPhotos")

Rel(web, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, qprofile, "Sends GetPublicProfileQuery")
Rel(ctrl, qlist, "Sends GetMemberListingsQuery")
Rel(qlist, cards, "Maps listings")
Rel(qprofile, port, "Member by NormalizedDisplayName; counts Completed sales and Active listings")
Rel(qlist, port, "Pages Active listings")
Rel(port, db, "Reads", "EF Core")
@enduml
