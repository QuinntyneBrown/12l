@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View a member profile

Container(web, "12L Web", "Angular", "MemberProfilePageComponent, ProfileHeaderComponent, RatingSummaryComponent, MembersApiService")

Container_Boundary(api, "12L API") {
  Component(ctrl, "MembersController", "ASP.NET Core controller", "Anonymous endpoints under PublicReadPolicy, rate limited, output cached")
  Component(qprofile, "GetPublicProfileQueryHandler", "MediatR handler", "Returns PublicProfileDto or member.unavailable")
  Component(qlist, "GetMemberListingsQueryHandler", "MediatR handler", "Active listings, 24 per page")
  Component(qrev, "GetMemberReviewsQueryHandler", "MediatR handler", "Published reviews with replies")
  Component(rep, "MemberReputation", "Domain entity", "Published review count, stars total, completed sales")
  Component(onrev, "UpdateReputationOnReviewPublishedHandler", "MediatR notification handler", "Adds a published review to the totals")
  Component(onord, "UpdateReputationOnOrderCompletedHandler", "MediatR notification handler", "Adds a completed sale")
  Component(reader, "IRatingSummaryReader", "Read port", "Shares the rating summary with catalog")
}
ContainerDb(db, "12L database", "SQL Server", "Members, MemberReputations, Listings, Reviews")

Rel(web, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, qprofile, "Sends GetPublicProfileQuery")
Rel(ctrl, qlist, "Sends GetMemberListingsQuery")
Rel(ctrl, qrev, "Sends GetMemberReviewsQuery")
Rel(qprofile, rep, "Reads RatingSummary")
Rel(onrev, rep, "ApplyPublishedReview")
Rel(onord, rep, "ApplyCompletedSale")
Rel(reader, rep, "Reads")
Rel(qprofile, db, "Projects public columns", "EF Core")
Rel(qlist, db, "Reads Listings", "EF Core")
Rel(qrev, db, "Reads Reviews", "EF Core")
Rel(onrev, db, "Upserts MemberReputations", "EF Core")
Rel(onord, db, "Upserts MemberReputations", "EF Core")
@enduml
