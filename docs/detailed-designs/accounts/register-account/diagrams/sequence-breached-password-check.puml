@startuml
title UML sequence behaviour — Breached-password check
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
box "Backend — Application and Domain (TwelveL.Application, TwelveL.Domain)" #ECFDF3
  participant "PasswordPolicy" as policy
end box
box "Backend — Infrastructure (TwelveL.Infrastructure)" #FFF4E5
  participant "BreachedPasswordClient" as client
  database "Distributed cache" as cache
end box
box "External — Breached-password service" #F2F4F7
  participant "Range API" as ext
end box
policy -> policy : Length 12–128 characters (L2-001)
alt length out of range
  policy --> policy : password_too_short or password_too_long
else length valid
  policy -> client : IsBreachedAsync(password)
  client -> client : SHA-1 hash, upper-case hex; prefix = first 5 characters
  client -> cache : GET 12l:cache:breach-range:{prefix}
  alt cached range present
    cache --> client : Suffix list
  else cache miss
    client -> ext : GET /range/{prefix} (Add-Padding: true), timeout from configuration
    alt service answers
      ext --> client : Suffixes with counts
      client -> cache : SET 12l:cache:breach-range:{prefix} (TTL from configuration)
    else timeout or error
      client --> policy : BreachCheckUnavailable
      note right of policy : Fail-open or fail-closed is <TO SUPPLY>
    end
  end
  client -> client : Compare remaining 35 characters with suffixes
  client --> policy : true when a suffix matches
  policy --> policy : password_breached when true (L2-001)
end
@enduml
