@startuml
title UML sequence behaviour — Change password from settings
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
actor "Member" as actor
box "Frontend — 12L Web application" #E0F2FE
  participant "ChangePasswordDialog" as dlg
  participant "AccountsApi" as client
end box
box "Backend — 12L API application (TwelveL.Api)" #D1FADF
  participant "AccountPasswordController" as ctrl
end box
box "Backend — Application and Domain (TwelveL.Application, TwelveL.Domain)" #ECFDF3
  participant "ChangePasswordCommandHandler" as handler
  participant "SessionRevoker" as revoker
end box
box "Backend — Infrastructure (TwelveL.Infrastructure)" #FFF4E5
  database "12L database" as db
end box
actor -> dlg : Current password, new password; Change password
dlg -> dlg : State busy: Cancel disabled
dlg -> client : changePassword(current, new)
client -> ctrl : POST /api/accounts/me/password (policy Member)
ctrl -> handler : Send ChangePasswordCommand(memberId, sid)
handler -> db : Load Member
handler -> handler : Verify current password; validate new password
alt current password wrong or new password invalid
  ctrl --> client : 400 validation_failed, errors.currentPassword / errors.newPassword
  dlg --> actor : "That’s not your current password", "Password must be at least 12 characters"
else valid
  handler -> db : Member.ChangePassword; INotificationPublisher.Enqueue(PasswordChanged)
  handler -> revoker : RevokeAllAsync(memberId, PasswordChanged, except current sid)
  ctrl --> client : 204 No Content
  dlg --> actor : Dialog closes; success toast; Password row shows today's date
end
alt server error
  ctrl --> client : 500 problem details
  dlg --> actor : "Couldn’t change your password" with Ref; inputs kept
end
@enduml
