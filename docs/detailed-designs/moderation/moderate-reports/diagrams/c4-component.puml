@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Moderate reports

Container(web, "12L Web", "Angular", "ModerationQueuePageComponent, ReportDetailPageComponent, ResolveReportDialogComponent, ModerationApiService")
Container_Boundary(api, "12L API") {
  Component(qctrl, "ModerationQueueController", "ASP.NET Core controller", "GET /api/admin/queue")
  Component(rctrl, "AdminReportsController", "ASP.NET Core controller", "GET /api/admin/reports/{number}, POST .../resolution")
  Component(qh, "GetModerationQueueQueryHandler", "MediatR handler", "Open reports and open order problems, oldest first")
  Component(dh, "GetReportDetailQueryHandler", "MediatR handler", "Report, submissions, target summary, resolution")
  Component(rh, "ResolveReportCommandHandler", "MediatR handler", "Dismiss, remove listing or suspend member")
  Component(report, "Report", "Domain aggregate", "Open to resolved transitions")
  Component(listing, "Listing", "Domain entity", "RemoveByAdministrator, ReturnToCatalog")
  Component(suspend, "MemberSuspensionService", "Domain service (suspend-member)", "Suspends the member")
  Component(orders, "IOrderModerationPort", "Port (orders subsystem)", "Order state for a listing; cancel and refund")
  Component(problems, "IOrderProblemQueueSource", "Port (orders subsystem)", "Open order problems for the queue")
  Component(audit, "IAuditLog", "Port (audit-log feature)", "Appends AuditEntry")
  Component(outbox, "IOutbox", "Port", "Writes email messages in the transaction")
  ComponentDb(db, "12L database", "SQL Server", "Reports, Listings, Members, Orders, AuditEntries, OutboxMessages")
}
Rel(web, qctrl, "Loads queue", "JSON/HTTPS")
Rel(web, rctrl, "Loads detail, posts decision", "JSON/HTTPS")
Rel(qctrl, qh, "Sends GetModerationQueueQuery")
Rel(qh, problems, "Reads open problems")
Rel(rctrl, dh, "Sends GetReportDetailQuery")
Rel(rctrl, rh, "Sends ResolveReportCommand")
Rel(rh, report, "Resolve()")
Rel(rh, listing, "Remove or return to catalog")
Rel(rh, suspend, "Suspend seller or member")
Rel(rh, orders, "Check order; cancel and refund on confirm")
Rel(rh, audit, "Record action")
Rel(rh, outbox, "Queue email")
Rel(qh, db, "Reads", "EF Core")
Rel(rh, db, "Commits one unit of work", "EF Core")
@enduml
