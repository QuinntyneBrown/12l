@startuml
title UML sequence behaviour — Resolve a report by suspending the member
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Administrator" as actor
box "Frontend — 12L Web application" #E0F2FE
  participant "ResolveReportDialogComponent" as dialog
  participant "ModerationApiService" as client
end box
box "Backend — 12L API application" #D1FADF
  participant "AdminReportsController" as controller
end box
box "Backend — TwelveL.Application and TwelveL.Domain" #ECFDF3
  participant "ResolveReportCommandHandler" as handler
  participant "MemberSuspensionService" as suspension
  participant "Report" as report
  participant "IAuditLog" as audit
end box
box "Backend — TwelveL.Infrastructure" #FFF4E5
  database "12L database" as db
  participant "Distributed cache" as cache
end box
actor -> dialog : Choose "Suspend member", enter reason
dialog -> client : resolve(number, {decision: SuspendMember, reason})
client -> controller : POST /api/admin/reports/{number}/resolution
controller -> handler : Send ResolveReportCommand
handler -> db : Load Report, target Listing and its seller, or target Member
alt member already suspended
  controller --> client : 409 member.already_suspended
end
handler -> suspension : Suspend(member, reason, admin, now) (L2-046)
handler -> handler : Listing.ReturnToCatalog() clears hidden flag; seller suspension hides listings
handler -> report : Resolve(SuspendMember, reason, admin, now)
handler -> audit : Record("Member suspended", handle, reason) (L2-047)
handler -> db : SaveChanges with MemberSuspendedEmail outbox message
db --> handler : Committed
handler -> cache : Evict member:status:{memberId}
controller --> client : 200 OK
client --> dialog : Close
dialog --> actor : Report resolved; seller listings hidden
@enduml
