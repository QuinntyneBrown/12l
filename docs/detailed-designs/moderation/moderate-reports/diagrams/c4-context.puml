@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Moderate reports

Person(admin, "Administrator", "Reviews the moderation queue and resolves reports")
Person(seller, "Affected member", "Seller of a removed listing or a suspended member")
Person(buyer, "Buyer", "Holds a reservation or Paid order on a removed listing")
System(twelvel, "12L", "Marketplace for men's US size 12 shoes and size L clothing")
System_Ext(email, "Email provider", "Sends transactional email")
System_Ext(pay, "Payment provider", "Refunds and cancels payments")

Rel(admin, twelvel, "Dismisses reports, removes listings, suspends members using", "HTTPS")
Rel(twelvel, email, "Sends the decision reason via", "HTTPS API")
Rel(twelvel, pay, "Refunds a cancelled order via", "HTTPS API")
Rel(email, seller, "Delivers listing-removed or suspension email to")
Rel(email, buyer, "Delivers cancellation and refund email to")
@enduml
