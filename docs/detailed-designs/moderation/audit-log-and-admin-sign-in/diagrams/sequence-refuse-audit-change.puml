@startuml
title UML sequence behaviour — Refuse an audit entry change
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "API caller" as actor
box "Backend — 12L API application" #D1FADF
  participant "AuditLogController" as controller
end box
box "Backend — TwelveL.Infrastructure" #FFF4E5
  participant "AuditEntryImmutabilityInterceptor" as guard
  database "12L database" as db
end box
actor -> controller : PUT, PATCH or DELETE /api/admin/audit/{id}
controller -> controller : RefuseChange(id) (L2-047)
controller --> actor : 405 audit.immutable, Allow: GET
note over guard, db : Defence in depth for code paths inside the application
guard -> guard : SaveChanges sees Modified or Deleted AuditEntry
alt modified or deleted entry tracked
  guard --> guard : Throw AuditEntryImmutableException; transaction rolls back
end
guard -> db : Direct UPDATE or DELETE on AuditEntries
alt application database login
  db --> guard : Permission denied (DENY UPDATE, DELETE)
else any login
  db --> guard : INSTEAD OF trigger TR_AuditEntries_Immutable raises error
end
@enduml
