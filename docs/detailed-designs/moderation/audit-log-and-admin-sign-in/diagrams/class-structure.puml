@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Audit log and administrator sign-in

enum AuditAction {
  ListingRemoved
  MemberSuspended
  MemberReinstated
  ReportDismissed
  ProblemResolvedFullRefund
  ProblemResolvedPartialRefund
  ProblemResolvedPayoutReleased
}
class AuditEntry <<immutable>> {
  +long Id
  +DateTime OccurredAt
  +Guid AdministratorId
  +string AdministratorName
  +AuditAction Action
  +string TargetType
  +Guid TargetKey
  +string TargetDisplayId
  +string Reason
  +string CorrelationId
  {static} +Create(...): AuditEntry
}
interface IAuditLog {
  +Record(action: AuditAction, targetType: string, targetKey: Guid, targetDisplayId: string, reason: string): void
}
class AuditLog {
  -TwelveLDbContext db
  -ICurrentAdministrator admin
  -ICorrelationContext correlation
  -TimeProvider clock
}
class AuditEntryImmutabilityInterceptor {
  +SavingChangesAsync(eventData, result, ct): ValueTask
}
class GetAuditLogQuery {
  +string? Target
  +AuditAction? Action
  +string? Cursor
}
class GetAuditLogQueryHandler {
  +Handle(query: GetAuditLogQuery, ct): Task<AuditLogPage>
}
class AuditLogController {
  +Get(query): Task<IActionResult>
  +RefuseChange(id: long): IActionResult
}
class AdministratorTotpCredential {
  +Guid AdministratorId
  +byte[] ProtectedSecret
  +long LastAcceptedTimeStep
  +DateTime EnrolledAt
  +byte[] RowVersion
}
interface ITotpVerifier {
  +Verify(credential: AdministratorTotpCredential, code: string, now: DateTime): TotpResult
}
class VerifyAdminSecondFactorCommand {
  +string Code
}
class VerifyAdminSecondFactorCommandHandler {
  +Handle(command, ct): Task<Result>
}
interface ISessionTokenService {
  +UpgradeToSecondFactorAsync(sessionId: Guid, now: DateTime): Task
}
class AdminSecurityOptions {
  +int TotpDigits = 6
  +int TotpStepSeconds = 30
  +int AllowedClockDriftSteps = 1
  +int MaxVerifyAttempts
}

AuditLog ..|> IAuditLog
AuditLog ..> AuditEntry : creates
AuditEntry --> AuditAction
AuditEntryImmutabilityInterceptor ..> AuditEntry : guards
GetAuditLogQueryHandler ..> GetAuditLogQuery : handles
GetAuditLogQueryHandler ..> AuditEntry : reads
AuditLogController ..> GetAuditLogQuery : sends
VerifyAdminSecondFactorCommandHandler ..> VerifyAdminSecondFactorCommand : handles
VerifyAdminSecondFactorCommandHandler --> ITotpVerifier
VerifyAdminSecondFactorCommandHandler --> ISessionTokenService
VerifyAdminSecondFactorCommandHandler --> AdministratorTotpCredential : loads / updates
ITotpVerifier ..> AdminSecurityOptions : reads
@enduml
