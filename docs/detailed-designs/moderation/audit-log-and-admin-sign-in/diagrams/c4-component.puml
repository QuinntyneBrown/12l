@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Audit log and administrator sign-in

Container(web, "12L Web", "Angular", "AdminVerifyPageComponent, AuditLogPageComponent, adminGuard")
Container_Boundary(api, "12L API") {
  Component(vctrl, "AdminVerificationController", "ASP.NET Core controller", "POST /api/admin/verify")
  Component(vh, "VerifyAdminSecondFactorCommandHandler", "MediatR handler", "Checks TOTP and upgrades the session")
  Component(totp, "ITotpVerifier", "Port", "RFC 6238 code check with replay guard")
  Component(sessions, "ISessionTokenService", "Port (accounts)", "Reissues cookies with amr otp")
  Component(policy, "AdministratorWithSecondFactor", "Authorization policy", "Administrator role and amr otp")
  Component(actrl, "AuditLogController", "ASP.NET Core controller", "GET /api/admin/audit; PUT, PATCH, DELETE return 405")
  Component(qh, "GetAuditLogQueryHandler", "MediatR handler", "Filters by target and action, newest first")
  Component(log, "AuditLog", "IAuditLog implementation", "Adds AuditEntry to the current unit of work")
  Component(guard, "AuditEntryImmutabilityInterceptor", "EF Core SaveChangesInterceptor", "Refuses modified or deleted AuditEntry")
  ComponentDb(db, "12L database", "SQL Server", "AuditEntries with INSTEAD OF trigger and INSERT/SELECT-only grant")
}
Rel(web, vctrl, "Posts code", "JSON/HTTPS")
Rel(web, actrl, "Reads log", "JSON/HTTPS")
Rel(vctrl, vh, "Sends VerifyAdminSecondFactorCommand")
Rel(vh, totp, "Verify code")
Rel(vh, sessions, "Upgrade session")
Rel(actrl, policy, "Requires")
Rel(actrl, qh, "Sends GetAuditLogQuery")
Rel(qh, db, "Selects", "EF Core")
Rel(log, guard, "Saved through")
Rel(guard, db, "Inserts only", "EF Core")
@enduml
