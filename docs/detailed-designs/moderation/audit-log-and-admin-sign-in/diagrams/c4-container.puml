@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Audit log and administrator sign-in

Person(admin, "Administrator", "Signs in and reads the audit log")
System_Boundary(twelvel, "12L") {
  Container(web, "12L Web", "Angular", "Sign-in page, admin verification page, audit log page")
  Container(api, "12L API", "ASP.NET Core Web API", "Password sign-in, TOTP verification, audit log query, append-only writes")
  ContainerDb(db, "12L database", "SQL Server", "AuditEntries (append-only), AdministratorTotpCredentials, Sessions")
  ContainerDb(cache, "Distributed cache", "Redis", "Rate-limit counters, refresh-token families")
}
Rel(admin, web, "Uses", "HTTPS")
Rel(web, api, "POST /api/admin/verify, GET /api/admin/audit", "JSON/HTTPS")
Rel(api, db, "Inserts and selects audit entries; reads TOTP secret", "EF Core")
Rel(api, cache, "Counts verification attempts", "RESP")
@enduml
