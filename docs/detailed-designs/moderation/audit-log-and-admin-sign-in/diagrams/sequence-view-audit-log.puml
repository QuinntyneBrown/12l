@startuml
title UML sequence behaviour — Record and view the audit log
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Administrator" as actor
box "Frontend — 12L Web application" #E0F2FE
  participant "AuditLogPageComponent" as page
  participant "ModerationApiService" as client
end box
box "Backend — 12L API application" #D1FADF
  participant "AuditLogController" as controller
end box
box "Backend — TwelveL.Application" #ECFDF3
  participant "Any administrator command handler" as cmd
  participant "AuditLog" as log
  participant "GetAuditLogQueryHandler" as handler
end box
box "Backend — TwelveL.Infrastructure" #FFF4E5
  participant "AuditEntryImmutabilityInterceptor" as guard
  database "12L database" as db
end box
== Recording (inside each administrator action) ==
cmd -> log : Record(ListingRemoved, Listing, key, "L-20802", reason)
log -> log : AuditEntry.Create(admin, action, target, reason, now, correlation ID)
cmd -> guard : SaveChanges (same transaction as the action)
guard -> guard : Only Added AuditEntry allowed
guard -> db : INSERT AuditEntries (L2-047)
== Viewing ==
actor -> page : Open /admin/audit, optional Target ID and Action
page -> page : Table skeleton
page -> client : getAuditLog({target, action, cursor})
client -> controller : GET /api/admin/audit?target=&action=&cursor=
controller -> controller : Policy AdministratorWithSecondFactor
controller -> handler : Send GetAuditLogQuery
handler -> db : SELECT newest first using IX_AuditEntries indexes
db --> handler : Rows
handler --> controller : AuditLogPage
alt failure
  controller --> client : 500 problem details
  client --> page : "Couldn't load the audit log" with Ref
end
controller --> client : 200 OK
alt no entries and no filter
  page --> actor : "No actions yet"
else filter matched nothing
  page --> actor : "No entries for <target>" with "Clear search"
else entries
  page --> actor : Time (ET), Administrator, Action, Target, Reason
end
@enduml
