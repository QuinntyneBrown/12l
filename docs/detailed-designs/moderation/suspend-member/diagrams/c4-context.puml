@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Suspend and reinstate a member

Person(admin, "Administrator", "Suspends and reinstates members")
Person(member, "Suspended member", "Signs in to see and ship open orders")
Person(buyer, "Buyer", "Keeps an open order with the suspended seller")
System(twelvel, "12L", "Marketplace for men's US size 12 shoes and size L clothing")
System_Ext(email, "Email provider", "Sends transactional email")

Rel(admin, twelvel, "Suspends and reinstates members using", "HTTPS")
Rel(member, twelvel, "Signs in, ships open orders using", "HTTPS")
Rel(buyer, twelvel, "Tracks open orders using", "HTTPS")
Rel(twelvel, email, "Sends the suspension reason via", "HTTPS API")
@enduml
