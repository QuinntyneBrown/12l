@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Suspend and reinstate a member

enum MemberStatus {
  Active
  Suspended
  Closed
}
class Member {
  +Guid Id
  +string Handle
  +MemberStatus Status
  +byte[] RowVersion
  +Suspend(reason: string, adminId: Guid, now: DateTime): MemberSuspension
  +Reinstate(reason: string, adminId: Guid, now: DateTime): void
}
class MemberSuspension {
  +Guid Id
  +Guid MemberId
  +DateTime SuspendedAt
  +Guid SuspendedByAdministratorId
  +string SuspensionReason
  +DateTime? ReinstatedAt
  +Guid? ReinstatedByAdministratorId
  +string? ReinstatementReason
}
class SuspendMemberCommand {
  +Guid MemberId
  +string Reason
  +Guid AdministratorId
}
class ReinstateMemberCommand {
  +Guid MemberId
  +string Reason
  +Guid AdministratorId
}
class SuspendMemberCommandHandler
class ReinstateMemberCommandHandler
class MemberSuspensionService {
  +Suspend(member: Member, reason: string, adminId: Guid, now: DateTime): void
  +Reinstate(member: Member, reason: string, adminId: Guid, now: DateTime): void
}
class NotSuspendedRequirement
class NotSuspendedAuthorizationHandler {
  #HandleRequirementAsync(ctx, req: NotSuspendedRequirement): Task
}
interface IMemberStatusReader {
  +GetStatusAsync(memberId: Guid): Task<MemberStatus>
  +EvictAsync(memberId: Guid): Task
}
interface IAuditLog {
  +Record(action: AuditAction, targetType: string, targetId: string, reason: string): void
}
interface IOutbox {
  +Enqueue(message: object): void
}
class MemberSuspendedEmail {
  +Guid MemberId
  +string Reason
}

Member --> MemberStatus
Member "1" *-- "*" MemberSuspension : history
SuspendMemberCommandHandler ..> SuspendMemberCommand : handles
ReinstateMemberCommandHandler ..> ReinstateMemberCommand : handles
SuspendMemberCommandHandler --> MemberSuspensionService
ReinstateMemberCommandHandler --> MemberSuspensionService
MemberSuspensionService --> Member : mutates
MemberSuspensionService --> IAuditLog
MemberSuspensionService --> IOutbox
MemberSuspensionService --> IMemberStatusReader : evicts
MemberSuspensionService ..> MemberSuspendedEmail : creates
NotSuspendedAuthorizationHandler ..> NotSuspendedRequirement : handles
NotSuspendedAuthorizationHandler --> IMemberStatusReader
@enduml
