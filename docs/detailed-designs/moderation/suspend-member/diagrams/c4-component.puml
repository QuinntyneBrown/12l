@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Suspend and reinstate a member

Container(web, "12L Web", "Angular", "MemberAdminPageComponent, SuspendMemberDialogComponent, AccountBannerComponent")
Container_Boundary(api, "12L API") {
  Component(ctrl, "AdminMembersController", "ASP.NET Core controller", "GET member, POST suspension, POST reinstatement")
  Component(sh, "SuspendMemberCommandHandler", "MediatR handler", "Loads member and calls the service")
  Component(rh, "ReinstateMemberCommandHandler", "MediatR handler", "Loads member and calls the service")
  Component(svc, "MemberSuspensionService", "Application service", "Applies transition, audit entry, outbox email")
  Component(member, "Member", "Domain entity", "Active to Suspended to Active")
  Component(policy, "NotSuspendedAuthorizationHandler", "ASP.NET Core authorization handler", "403 account.suspended on list, buy, review, report")
  Component(reader, "IMemberStatusReader", "Port", "Cached member status")
  Component(audit, "IAuditLog", "Port", "Appends AuditEntry")
  ComponentDb(db, "12L database", "SQL Server", "Members, MemberSuspensions")
  ComponentDb(cache, "Distributed cache", "Redis", "member:status:{memberId}")
}
Rel(web, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, sh, "Sends SuspendMemberCommand")
Rel(ctrl, rh, "Sends ReinstateMemberCommand")
Rel(sh, svc, "Suspend()")
Rel(rh, svc, "Reinstate()")
Rel(svc, member, "Mutates")
Rel(svc, audit, "Records")
Rel(svc, db, "Persists with outbox", "EF Core")
Rel(svc, cache, "Evicts status after commit")
Rel(policy, reader, "Reads status")
Rel(reader, cache, "Reads, falls back to database")
@enduml
