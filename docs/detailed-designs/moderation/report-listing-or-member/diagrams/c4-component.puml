@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Report a listing or member

Container(web, "12L Web", "Angular", "ReportListingDialogComponent, ReportMemberDialogComponent, ReportsApiService")
Container_Boundary(api, "12L API") {
  Component(ctrl, "ReportsController", "ASP.NET Core controller", "POST /api/reports; policies VerifiedMember and NotSuspended")
  Component(validator, "SubmitReportCommandValidator", "FluentValidation", "Reason in the allowed set; details required for Other")
  Component(handler, "SubmitReportCommandHandler", "MediatR handler", "Resolves the target, adds the submission, applies the auto-hide rule")
  Component(report, "Report", "Domain aggregate", "Open report case for one target with its submissions")
  Component(listing, "Listing", "Domain entity", "Carries IsHiddenPendingReview")
  Component(repo, "IReportRepository", "Repository port", "Loads the open case for a target")
  ComponentDb(db, "12L database", "SQL Server", "Reports, ReportSubmissions, Listings")
}
Rel(web, ctrl, "Sends report", "JSON/HTTPS")
Rel(ctrl, validator, "Validates SubmitReportCommand")
Rel(ctrl, handler, "Sends SubmitReportCommand")
Rel(handler, repo, "Loads or creates open case")
Rel(handler, report, "AddSubmission()")
Rel(handler, listing, "HidePendingReview() at 3 reporters")
Rel(repo, db, "Reads and writes", "EF Core")
@enduml
