@startuml
title UML sequence behaviour — Report a listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Verified member" as actor
box "Frontend — 12L Web application" #E0F2FE
  participant "ReportListingDialogComponent" as dialog
  participant "ReportsApiService" as client
end box
box "Backend — 12L API application" #D1FADF
  participant "ReportsController" as controller
end box
box "Backend — TwelveL.Application and TwelveL.Domain" #ECFDF3
  participant "SubmitReportCommandValidator" as validator
  participant "SubmitReportCommandHandler" as handler
  participant "Report" as report
  participant "Listing" as listing
end box
box "Backend — TwelveL.Infrastructure" #FFF4E5
  database "12L database" as db
end box
actor -> dialog : Choose reason, optional details, "Send report"
dialog -> dialog : Require details when reason is Other (L2-044)
dialog -> client : submit({targetType: Listing, targetId, reason, details})
client -> controller : POST /api/reports
controller -> controller : Authenticate; apply VerifiedMember and NotSuspended policies
alt anonymous, unverified or suspended
  controller --> client : 401 or 403 problem details
  client --> dialog : Show error
end
controller -> validator : Validate SubmitReportCommand
alt reason Other with empty details
  validator --> controller : details invalid
  controller --> client : 422 report.details_required
  client --> dialog : Inline "Tell us what's wrong" (invalid state)
end
controller -> handler : Send SubmitReportCommand
handler -> db : Load listing (Active or Reserved, not own)
alt listing not visible to caller
  handler --> controller : NotFound
  controller --> client : 404
end
handler -> db : Check ReportSubmissions for (reporter, Listing, listingId)
alt already reported by this member
  handler --> controller : Conflict
  controller --> client : 409 report.already_reported (L2-044)
  client --> dialog : "You've already reported this listing" (already state)
end
handler -> db : Load open Report for listing (or create one with next R- number)
handler -> report : AddSubmission(reporter, reason, details)
report --> handler : DistinctReporterCount
opt DistinctReporterCount reaches 3 (L2-044)
  handler -> listing : HidePendingReview(now)
  listing --> handler : IsHiddenPendingReview = true
end
handler -> db : SaveChanges in one transaction (RowVersion check, unique index)
alt concurrency conflict or unique index violation
  db --> handler : DbUpdateException
  handler -> handler : Retry once, or map duplicate to 409
end
db --> handler : Committed
handler --> controller : SubmitReportResponse
controller --> client : 201 Created
client --> dialog : Success
dialog --> actor : "Thanks, our team will review this"
@enduml
