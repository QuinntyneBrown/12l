@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Report a listing or member

Person(member, "Verified member", "Reports a listing or member")
System_Boundary(twelvel, "12L") {
  Container(web, "12L Web", "Angular", "Report listing and report member dialogs")
  Container(api, "12L API", "ASP.NET Core Web API", "Validates reports, de-duplicates reporters, hides a listing after 3 reporters")
  ContainerDb(db, "12L database", "SQL Server", "Reports, report submissions, listings")
  ContainerDb(cache, "Distributed cache", "Redis", "Member status and rate-limit counters")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "POST /api/reports", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, cache, "Reads member status, counts requests", "RESP")
@enduml
