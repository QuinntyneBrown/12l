@startuml
title UML sequence behaviour — Request a data export
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — 12L Web application" #E0F2FE
  participant "DataExportDialogComponent" as dialog
  participant "PrivacyApiService" as client
end box
box "Backend — 12L API application" #D1FADF
  participant "PrivacyExportsController" as controller
end box
box "Backend — TwelveL.Application and Domain" #ECFDF3
  participant "RequestDataExportCommandHandler" as handler
  participant "DataExportRequest" as entity
end box
box "Backend — TwelveL.Infrastructure" #FFF4E5
  database "12L database" as db
end box
actor -> dialog : Open from Settings > Your data
actor -> dialog : "Request download"
dialog -> dialog : busy state (Cancel disabled, aria-busy)
dialog -> client : requestExport()
client -> controller : POST /api/privacy/exports + anti-forgery token
controller -> controller : Authenticate, MemberOnly policy, rate limit
alt signed in and token valid
  controller -> handler : Send RequestDataExportCommand
  handler -> db : Find open request (Requested or Processing)
  alt open request exists
    db --> handler : Existing request
  else none
    handler -> entity : new DataExportRequest(Requested)
    handler -> db : Insert request + outbox DataExportRequested (one transaction, L2-055)
    db --> handler : Commit
  end
  handler --> controller : ExportRequestView
  controller --> client : 202 Accepted + Location
  client --> dialog : View
  dialog --> actor : success "Request received" — link works for 7 days, only for you
else 401 or 400 or 429
  controller --> client : Problem details
  client --> dialog : Error
  dialog --> actor : default state with error alert and Ref (<TO SUPPLY> copy)
end
@enduml
