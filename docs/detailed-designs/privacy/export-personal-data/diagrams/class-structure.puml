@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Export personal data

enum DataExportStatus {
  Requested
  Processing
  Ready
  Expired
  Failed
}
class DataExportRequest {
  +Guid Id
  +Guid MemberId
  +DataExportStatus Status
  +DateTimeOffset RequestedAt
  +DateTimeOffset? StartedAt
  +DateTimeOffset? ReadyAt
  +DateTimeOffset? ExpiresAt
  +DateTimeOffset? FailedAt
  +int Attempts
  +string? StorageKey
  +long? SizeBytes
  +string? Sha256
  +byte[] RowVersion
  +Start(now): void
  +MarkReady(key, size, hash, now, lifetime): void
  +MarkFailed(now): void
  +Expire(now): void
  +IsDownloadableBy(memberId, now): bool
}
class RequestDataExportCommand {
  +Guid MemberId
}
class RequestDataExportCommandHandler {
  +Handle(cmd): Task<ExportRequestView>
}
class GetDataExportQueryHandler {
  +Handle(query): Task<Result<ExportRequestView>>
}
class OpenDataExportFileQueryHandler {
  +Handle(query): Task<Result<ExportFile>>
}
class GenerateDataExportHandler {
  +Handle(msg: DataExportRequested): Task
}
class DataExportExpiryJob {
  +RunAsync(ct): Task
}
class PersonalDataExportComposer {
  +ComposeAsync(memberId): Task<JsonObject>
}
interface IPersonalDataSection {
  +string Key
  +BuildAsync(memberId): Task<JsonNode>
}
class ProfileSection
class ListingsSection
class OrdersSection
class ReviewsSection
class NotificationSettingsSection
class SavedAddressesSection
class ExportDocumentGuard {
  +Check(doc, ownEmail): Result
}
interface IExportFileStore {
  +PutAsync(key, stream): Task
  +OpenReadAsync(key): Task<Stream>
  +DeleteAsync(key): Task
}
class ObjectStorageExportFileStore
interface IOutbox {
  +Enqueue(message): void
}
class ExportRequestView <<record>> {
  +Guid Id
  +string Status
  +DateTimeOffset RequestedAt
  +DateTimeOffset? ReadyAt
  +DateTimeOffset? ExpiresAt
  +string? FileName
  +long? SizeBytes
}

DataExportRequest --> DataExportStatus
RequestDataExportCommandHandler ..> RequestDataExportCommand : handles
RequestDataExportCommandHandler --> DataExportRequest : creates
RequestDataExportCommandHandler --> IOutbox : DataExportRequested
GetDataExportQueryHandler ..> ExportRequestView : returns
OpenDataExportFileQueryHandler --> IExportFileStore
GenerateDataExportHandler --> PersonalDataExportComposer
GenerateDataExportHandler --> ExportDocumentGuard
GenerateDataExportHandler --> IExportFileStore
GenerateDataExportHandler --> IOutbox : SendDataExportReadyEmail
GenerateDataExportHandler --> DataExportRequest : Start / MarkReady
DataExportExpiryJob --> DataExportRequest : Expire
DataExportExpiryJob --> IExportFileStore
PersonalDataExportComposer "1" o-- "*" IPersonalDataSection
IPersonalDataSection <|.. ProfileSection
IPersonalDataSection <|.. ListingsSection
IPersonalDataSection <|.. OrdersSection
IPersonalDataSection <|.. ReviewsSection
IPersonalDataSection <|.. NotificationSettingsSection
IPersonalDataSection <|.. SavedAddressesSection
IExportFileStore <|.. ObjectStorageExportFileStore
@enduml
