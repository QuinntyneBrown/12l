@startuml
title UML sequence behaviour — Carrier reports delivery
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
skinparam maxMessageSize 260
participant "Carrier tracking service" as carrier
box "Backend — 12L API application (TwelveL.Api)" #D1FADF
  participant "CarrierWebhookController" as cwh
end box
box "Backend — 12L Worker application (TwelveL.Worker)" #D1FADF
  participant "DeliveryPollingJob" as poll
end box
box "Backend — TwelveL.Application and TwelveL.Domain" #ECFDF3
  participant "MarkDeliveredCommandHandler" as h
  participant "Order" as order
end box
box "Backend — TwelveL.Infrastructure" #FFF4E5
  database "12L database" as db
end box
alt push from carrier service
  carrier -> cwh : POST /api/carriers/webhook (signed)
  cwh -> cwh : Verify signature
  alt invalid signature
    cwh --> carrier : 400, logged as security event
  else valid
    cwh -> h : Send MarkDeliveredCommand(trackingNumber, Carrier, deliveredAt)
  end
else polling
  poll -> db : Select Shipped orders not polled within Orders:DeliveryPollInterval
  poll -> carrier : GetStatusAsync(carrier, tracking)
  carrier --> poll : Delivered at time T
  poll -> h : Send MarkDeliveredCommand(orderId, Carrier, T)
end
h -> db : Load order
h -> order : MarkDelivered(Carrier, T)
alt already Delivered, Completed or Refunded
  order --> h : No-op (idempotent)
else Shipped
  order -> order : Append Shipped to Delivered, actor Carrier (L2-033)
  h -> db : Save order, enqueue OrderDelivered notification
  db --> h : Committed
end
@enduml
