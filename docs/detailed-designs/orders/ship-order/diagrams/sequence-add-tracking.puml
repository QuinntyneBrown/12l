@startuml
title UML sequence behaviour — Add tracking and mark the order Shipped
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
skinparam maxMessageSize 260
actor "Seller" as actor
box "Frontend — 12L Web application" #E0F2FE
  participant "SaleDetailPage" as page
  participant "AddTrackingDialog" as dlg
  participant "OrdersApiService" as client
end box
box "Backend — 12L API application (TwelveL.Api)" #D1FADF
  participant "OrdersController" as ctrl
end box
box "Backend — TwelveL.Application and TwelveL.Domain" #ECFDF3
  participant "AddTrackingCommandValidator" as val
  participant "AddTrackingCommandHandler" as h
  participant "Order" as order
end box
box "Backend — TwelveL.Infrastructure" #FFF4E5
  database "12L database" as db
end box
actor -> page : Choose "Add tracking"
page -> dlg : Open with order number and buyer handle
actor -> dlg : Choose carrier "USPS", enter tracking number, "Mark as shipped"
dlg -> client : addTracking(orderId, carrier, trackingNumber)
client -> ctrl : POST /api/orders/{id}/shipment
ctrl -> ctrl : Authenticate, apply MemberOnly policy (suspended sellers allowed, L2-046)
ctrl -> val : Validate AddTrackingCommand (L2-033)
alt empty or malformed tracking number
  val --> ctrl : Field errors
  ctrl --> client : 400 ProblemDetails "tracking.invalid"
  client --> dlg : Field error
  dlg --> actor : Show "That doesn't look like a USPS tracking number" (invalid state)
else valid
  ctrl -> h : Send AddTrackingCommand
  h -> db : Load order where SellerId = caller
  alt not the seller of the order
    db --> h : No row
    h --> ctrl : NotFound
    ctrl --> client : 404 ProblemDetails
  else seller owns the order
    db --> h : Order (Status Paid, RowVersion)
    h -> order : MarkShipped(carrier, tracking, Seller, now)
    alt status is not Paid (L2-032)
      order --> h : InvalidOrderTransitionException
      h --> ctrl : Conflict
      ctrl --> client : 409 ProblemDetails "order.invalid_transition"
      client --> dlg : Failure
      dlg --> actor : Show failed state, inputs kept
    else Paid
      order -> order : Append OrderStatusChange Paid to Shipped, actor Seller
      order --> h : OrderShipped event
      h -> db : Save order, status change and INotificationPublisher.Enqueue(OrderShipped) in one transaction
      db --> h : Committed (RowVersion checked)
      h --> ctrl : SaleDetailDto
      ctrl --> client : 200 OK
      client --> page : Updated sale
      page --> actor : Close dialog, show "Shipped" timeline with tracking link
    end
  end
end
@enduml
