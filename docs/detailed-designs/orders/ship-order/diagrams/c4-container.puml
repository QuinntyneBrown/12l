@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Ship an order

Person(seller, "Seller", "Ships the item")
Person(buyer, "Buyer", "Receives the item")
System_Boundary(twelvel, "12L") {
  Container(web, "12L Web", "Angular", "Sale detail page and Add tracking dialog")
  Container(api, "12L API", "ASP.NET Core", "Order endpoints and the order state machine")
  Container(worker, "12L Worker", ".NET worker service", "Ship-by reminder, ship deadline, delivery polling and outbox dispatch jobs")
  ContainerDb(db, "12L database", "SQL Server", "Orders, status history, outbox")
}
System_Ext(email, "Email provider", "Transactional email")
System_Ext(carrier, "Carrier tracking service", "<TO SUPPLY>")
System_Ext(pay, "Payment provider", "Refunds")

Rel(seller, web, "Uses", "HTTPS")
Rel(buyer, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(worker, db, "Reads due orders, writes transitions and outbox", "EF Core")
Rel(worker, email, "Dispatches outbox email", "HTTPS")
Rel(worker, pay, "Issues refunds", "HTTPS")
Rel(worker, carrier, "Polls tracking status", "HTTPS")
Rel(carrier, api, "Posts delivery events", "HTTPS webhook")
@enduml
