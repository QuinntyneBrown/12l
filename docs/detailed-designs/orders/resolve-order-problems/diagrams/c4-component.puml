@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Resolve order problems

Container(web, "12L Web", "Angular", "ReportProblemDialog, ProblemThread, ProblemDetailPage, ResolveProblemDialog")
Container_Boundary(api, "12L API") {
  Component(oc, "OrderProblemsController", "ASP.NET Core controller", "/api/orders/{id}/problem endpoints")
  Component(ac, "AdminProblemsController", "ASP.NET Core controller", "/api/admin/problems endpoints, AdministratorWithSecondFactor")
  Component(rep, "ReportProblemCommandHandler", "MediatR handler", "Opens the problem, holds the payout")
  Component(resp, "RespondToProblemCommandHandler", "MediatR handler", "Seller reply")
  Component(res, "ResolveProblemCommandHandler", "MediatR handler", "Refund or release, audit")
  Component(q, "OrderProblemQueueSource", "IOrderProblemQueueSource", "Open problems for the moderation queue")
  Component(dom, "OrderProblem, Order, Payout", "Domain", "Problem and order state")
  Component(audit, "IAuditLog", "Application port (moderation)", "Append-only audit entries")
  Component(img, "IImageInspector, IPhotoStorage", "Ports (listings)", "Photo checks and private storage")
}
Component(mod, "GetModerationQueueQueryHandler", "MediatR handler (moderation subsystem)", "Merges reports and problems, oldest first")
ContainerDb(db, "12L database", "SQL Server", "Problems")
Rel(web, oc, "Calls", "JSON/HTTPS")
Rel(web, ac, "Calls", "JSON/HTTPS")
Rel(oc, rep, "Sends ReportProblemCommand")
Rel(oc, resp, "Sends RespondToProblemCommand")
Rel(ac, res, "Sends ResolveProblemCommand")
Rel(mod, q, "GetOpenProblemsAsync")
Rel(rep, img, "Validates and stores photos")
Rel(rep, dom, "Opens problem, Payout.Hold(OpenProblem)")
Rel(res, dom, "Order.Refund or Complete, Payout release or cancel")
Rel(res, audit, "Record(ProblemResolved...)")
Rel(rep, db, "Saves", "EF Core")
Rel(res, db, "Saves", "EF Core")
Rel(q, db, "Reads open problems", "SQL")
@enduml
