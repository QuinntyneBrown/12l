@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Check out and pay

Container(web, "12L Web", "Angular", "CheckoutPage, HostedCardFields, ReservationTimer, OrderConfirmationPage, CheckoutApiService")
Container_Boundary(api, "12L API") {
  Component(cc, "CheckoutsController", "ASP.NET Core controller", "/api/checkouts endpoints")
  Component(wh, "PaymentWebhookController", "ASP.NET Core controller", "POST /api/payments/webhook")
  Component(start, "StartCheckoutCommandHandler", "MediatR handler", "Reserves the listing (L2-028, L2-029)")
  Component(quote, "SetCheckoutAddressCommandHandler", "MediatR handler", "Validates US address, prices tax and total")
  Component(paycmd, "SubmitPaymentCommandHandler", "MediatR handler", "Creates the provider payment with the idempotency key")
  Component(conf, "ConfirmPaymentCommandHandler", "MediatR handler", "Creates the Paid order or refunds a duplicate")
  Component(rel, "ReleaseCheckoutCommandHandler", "MediatR handler", "Releases a reservation")
  Component(dom, "Checkout, Listing, Payment, Order", "Domain", "Reservation and order rules")
  Component(ppa, "PaymentProviderAdapter", "Infrastructure adapter", "IPaymentProvider over the provider SDK")
  Component(ctx, "TwelveLDbContext", "EF Core", "Conditional reservation update, unique indexes")
}
Container_Boundary(worker, "12L Worker") {
  Component(exp, "ReservationExpiryJob", "Hosted service", "Releases checkouts past ExpiresAt")
}
ContainerDb(db, "12L database", "SQL Server", "Checkout state")
System_Ext(pay, "Payment provider", "Payments")

Rel(web, cc, "Calls", "JSON/HTTPS")
Rel(pay, wh, "Posts events", "Signed webhook")
Rel(cc, start, "Sends StartCheckoutCommand")
Rel(cc, quote, "Sends SetCheckoutAddressCommand")
Rel(cc, paycmd, "Sends SubmitPaymentCommand")
Rel(cc, rel, "Sends ReleaseCheckoutCommand")
Rel(wh, conf, "Sends ConfirmPaymentCommand / RecordPaymentFailureCommand")
Rel(exp, rel, "Sends ReleaseCheckoutCommand")
Rel(start, dom, "Reserves")
Rel(conf, dom, "Creates Order, marks Listing Sold")
Rel(paycmd, ppa, "CreatePaymentAsync")
Rel(quote, ppa, "QuoteTaxAsync")
Rel(wh, ppa, "VerifyWebhookSignature")
Rel(ppa, pay, "Calls", "HTTPS")
Rel(start, ctx, "Saves")
Rel(conf, ctx, "Saves")
Rel(ctx, db, "Persists", "SQL")
@enduml
