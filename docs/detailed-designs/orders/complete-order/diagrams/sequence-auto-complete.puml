@startuml
title UML sequence behaviour — Automatic completion 3 days after delivery
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
skinparam maxMessageSize 260
box "Backend — 12L Worker application (TwelveL.Worker)" #D1FADF
  participant "OrderAutoCompletionJob" as job
end box
box "Backend — TwelveL.Application and TwelveL.Domain" #ECFDF3
  participant "AutoCompleteOrderCommandHandler" as h
  participant "Order" as order
end box
box "Backend — TwelveL.Infrastructure" #FFF4E5
  database "12L database" as db
end box
job -> db : Every Orders:CompletionJobInterval select Delivered orders with DeliveredAt + 3 days <= now
db --> job : Candidate orders
loop each candidate
  job -> h : AutoCompleteOrderCommand(orderId)
  h -> db : Load order and open problem
  alt open problem exists (L2-034 criterion 3)
    h --> job : Skip; order stays Delivered
  else no open problem
    h -> order : Complete(System, now)
    order --> h : OrderCompleted
    h -> db : Save order and payout Releasable (L2-034 criterion 2)
    alt RowVersion changed (buyer reported a problem meanwhile)
      db --> h : Concurrency conflict
      h --> job : Skip; retried next run
    else committed
      db --> h : Committed
    end
  end
end
@enduml
