@startuml
title UML sequence behaviour — Process an uploaded photo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — 12L Worker application" #D1FADF
  participant "PhotoProcessingJob" as job
end box
box "Backend — TwelveL Infrastructure" #FFF4E5
  participant "ListingPhotoProcessor" as proc
  database "12L database" as db
  database "Photo storage" as storage
end box
job -> db : Claim next ProcessListingPhoto outbox message
db --> job : photoId
job -> db : Load ListingPhotos row
job -> storage : Get originals/{photoId}
storage --> job : Original bytes
job -> proc : ProcessAsync(original)
proc -> proc : Decode, apply EXIF orientation, drop EXIF, XMP, IPTC and ICC metadata (L2-017)
loop widths 400, 800, 1600 (never upscaled)
  proc -> proc : Resize, encode WebP and JPEG
  proc -> proc : Key version as {hash}/{width}, hash = SHA-256 of original (L2-059)
end
alt processing succeeds
  proc --> job : 6 encoded versions
  loop each version
    job -> storage : Put {hash}/{width}.{webp|jpg} with Cache-Control max-age=31536000, immutable
  end
  job -> db : Insert ListingPhotoVersions rows, mark photo Ready, complete outbox message
else decode fails or transient error
  proc --> job : Exception
  alt attempts below Outbox:MaxAttempts
    job -> db : Schedule retry with back-off
  else attempts exhausted
    job -> db : Mark photo Failed (PHOTO_PROCESSING_FAILED), complete message
  end
end
@enduml
