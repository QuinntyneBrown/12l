@startuml
title UML sequence behaviour — Clean up orphaned photos
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — 12L Worker application" #D1FADF
  participant "PhotoCleanupJob" as job
end box
box "Backend — TwelveL Infrastructure" #FFF4E5
  database "12L database" as db
  database "Photo storage" as storage
end box
job -> job : Run on schedule Photos:CleanupSchedule
job -> db : Select photos with ListingId null and CreatedAt older than Photos:UnattachedRetentionHours
db --> job : Orphaned photo rows
loop each orphaned photo
  job -> storage : Delete originals/{photoId}
  job -> db : Delete ListingPhotos and ListingPhotoVersions rows
end
job -> db : Select content hashes no longer referenced by any ListingPhotoVersions row
db --> job : Unreferenced hashes
loop each unreferenced hash
  job -> storage : Delete {hash}/400, 800 and 1600 .webp and .jpg
end
opt storage delete fails
  job -> job : Log warning with correlation ID; retry on next run
end
@enduml
