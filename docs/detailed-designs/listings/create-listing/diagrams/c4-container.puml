@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Create a listing

Person(seller, "Seller", "Lists an item for sale")
System_Boundary(twelvel, "12L") {
  Container(web, "12L Web", "Angular", "Sell page, listing form, fixed size, earnings estimate")
  Container(api, "12L API", "ASP.NET Core", "Categories, selling options, listing create, update and publish")
  ContainerDb(db, "12L database", "SQL Server", "Listings, listing photos, members")
  ContainerDb(cache, "Distributed cache", "Redis", "Listing publish rate-limit counters")
}
Rel(seller, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, cache, "Counts publishes per member per day", "RESP")
@enduml
