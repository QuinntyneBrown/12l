@startuml
title UML sequence behaviour — Save a listing as a draft
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Seller" as actor
box "Frontend — 12L Web application" #E0F2FE
  participant "ListingFormComponent" as form
  participant "ListingsApiService" as client
end box
box "Backend — 12L API application" #D1FADF
  participant "ListingsController" as controller
end box
box "Backend — TwelveL Application and Domain" #ECFDF3
  participant "SaveListingDraftValidator" as validator
  participant "CreateListingDraftCommandHandler" as handler
  participant "Listing" as entity
end box
box "Backend — TwelveL Infrastructure" #FFF4E5
  database "12L database" as db
end box
actor -> form : Choose "Save draft"
form -> client : createDraft(details) or updateListing(id, details)
client -> controller : POST /api/listings (anti-forgery header)
controller -> controller : Authenticate, apply TradingMember policy (L2-010)
controller -> validator : Validate CreateListingDraftCommand
alt category or subcategory not accepted
  validator --> controller : CATEGORY_INVALID
  controller --> client : 422 problem details (L2-011)
  client --> form : Field error on Category
else size sent and not the accepted size
  validator --> controller : SIZE_NOT_ACCEPTED
  controller --> client : 422 problem details (L2-013)
else field over its limit
  validator --> controller : LISTING_INVALID with per-field errors
  controller --> client : 422 problem details (L2-049)
else valid draft (only a category is required, L2-019)
  controller -> handler : Send CreateListingDraftCommand
  handler -> entity : CreateDraft(sellerId, details) sets Size from category (L2-013)
  entity --> handler : Listing in status Draft
  handler -> db : Insert Listings row, attach photo IDs in one unit of work
  db --> handler : Committed
  handler --> controller : Reference (L-<number>)
  controller --> client : 201 Created, Location /api/me/listings/{reference}
  client --> form : Store listingId; later saves use PUT /api/listings/{reference}
  form --> actor : "Draft saved" alert with link to your listings
end
@enduml
